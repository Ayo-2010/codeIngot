{
  "name": "codeingot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "generate:course-meta": "esbuild scripts/generate-course-meta.ts --bundle --platform=node --format=esm --alias:~=./app --outfile=.tmp/generate-course-meta.mjs --log-level=warning && node .tmp/generate-course-meta.mjs",
    "generate:section-loaders": "node scripts/generate-section-loaders.mjs"
  },
  "dependencies": {
    "@nuxtjs/color-mode": "^3.5.2",
    "@types/jspdf": "^1.3.3",
    "@vercel/analytics": "^2.0.1",
    "destr": "^2.0.3",
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "nuxt": "^4.5.2",
    "sucrase": "^3.35.1",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.16",
    "c12": "^3.3.4",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "@vercel/analytics": {
      "vue-router": "$vue-router"
    }
  }
}
